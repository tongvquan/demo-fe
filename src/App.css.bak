*{box-sizing:border-box}.welcome-page{min-height:100vh;display:grid;place-items:center;padding:32px 20px;position:relative;overflow:hidden;background:#f6f7fb;color:#182235}.glow{position:absolute;border-radius:50%;pointer-events:none}.glow-one{width:420px;height:420px;top:-210px;right:-120px;background:#e8e3ff}.glow-two{width:260px;height:260px;bottom:-130px;left:-90px;background:#dff5f1}.join-card{width:min(100%,460px);position:relative;padding:48px 48px 38px;border:1px solid #e8eaf1;border-radius:24px;background:rgba(255,255,255,.93);box-shadow:0 24px 70px rgba(38,47,78,.11);text-align:center}.brand-mark{width:52px;height:52px;margin:0 auto 25px;display:grid;place-items:center;border-radius:16px;color:#fff;font-size:24px;background:linear-gradient(135deg,#7668f2,#5545d3);box-shadow:0 10px 22px rgba(96,80,224,.28)}.eyebrow{margin-bottom:12px;color:#7568df;font-size:10px;font-weight:800;letter-spacing:1.8px}h1{margin:0;font:800 clamp(27px,5vw,34px)/1.15 Manrope,sans-serif;letter-spacing:-.8px}.intro{margin:13px 0 34px;color:#858da0;font-size:14px}form{text-align:left}label{display:block;margin-bottom:9px;color:#3c465a;font-size:12px;font-weight:700}.input-wrap{display:flex;align-items:center;height:50px;border:1px solid #dfe3ed;border-radius:11px;background:#fff;transition:border-color .2s,box-shadow .2s}.input-wrap:focus-within{border-color:#7568df;box-shadow:0 0 0 4px rgba(117,104,223,.12)}.at-sign{padding-left:15px;color:#a4aabb;font-size:15px}input{width:100%;height:100%;padding:0 14px 0 8px;border:0;outline:0;background:transparent;color:#222c40;font-size:14px}input::placeholder{color:#b3b9c5}button{width:100%;height:50px;margin-top:17px;border:0;border-radius:11px;color:#fff;background:#6659e8;box-shadow:0 8px 16px rgba(102,89,232,.25);font-size:13px;font-weight:700;cursor:pointer;transition:transform .2s,background .2s}button:hover{background:#5749d6;transform:translateY(-1px)}button span{margin-left:8px;font-size:17px;vertical-align:-1px}.success{margin:18px 0 0;padding:11px 12px;border-radius:9px;color:#218565;background:#eaf8f2;font-size:12px}.hint{margin:24px 0 0;color:#a3aaba;font-size:11px}.hint span{margin-right:5px;color:#48bd91;font-size:9px}.footer-note{position:absolute;bottom:24px;color:#aab0bf;font-size:11px}@media(max-width:520px){.join-card{padding:38px 25px 30px;border-radius:20px}.footer-note{display:none}}
